# Backend Configuration
# =====================

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=annoy_db
POSTGRES_PORT=5432

# API Configuration
URL_STR=/api/v1
PROJECT_NAME=Annoy - Data Anonymization Tool


# Frontend Configuration
# =====================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI-Enhanced Detection Settings (Ollama - Local AI)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
ENABLE_AI_DETECTION=true
AI_CONFIDENCE_THRESHOLD=70.0
OLLAMA_ANALYZE_ALL_COLUMNS=false  # Ne pas reclassifier les colonnes bien détectées



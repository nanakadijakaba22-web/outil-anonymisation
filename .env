# Backend Configuration
# =====================

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=annoy_db
POSTGRES_PORT=5432

# API Configuration
URL_STR=/api/v1
PROJECT_NAME=Annoy - Data Anonymization Tool

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Configuration
# =====================

# Backend API URL (for Next.js frontend, empty string means relative path)
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Settings
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./uploads

# Anonymization Settings
DEFAULT_PSEUDONYM_SEED=42

# AI-Enhanced Detection Settings (Ollama - Local AI)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
ENABLE_AI_DETECTION=true
AI_CONFIDENCE_THRESHOLD=70.0
OLLAMA_ANALYZE_ALL_COLUMNS=false  # Ne pas reclassifier les colonnes bien détectées

# Environment Configuration
PYTHONPATH=./backend

# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Backend Configuration
# =====================

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=annoy_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=annoy_production
POSTGRES_PORT=5432

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Annoy - Data Anonymization Tool

# CORS Origins (comma-separated, use your domain)
BACKEND_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# File Upload Settings
MAX_UPLOAD_SIZE=1073741824  # 1GB in bytes
UPLOAD_DIR=./uploads

# Anonymization Settings (use a secure random seed in production)
DEFAULT_PSEUDONYM_SEED=CHANGE_ME_RANDOM_NUMBER

# Frontend Configuration
# =====================

# Backend API URL (for Next.js frontend)
# In production, this should be your public API URL
NEXT_PUBLIC_API_URL=https://your-domain.com

# Security Settings
# =================

# Set to 'production' in production
NODE_ENV=production

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# JWT secret (if using authentication, generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Monitoring & Logging
# ====================

# Sentry DSN (optional, for error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Email Configuration (optional, for notifications)
# =================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com

# Backup Configuration (optional)
# ===============================

# S3_BUCKET=your-backup-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_REGION=us-east-1

# Backend Configuration
# =====================

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=annoy_db
POSTGRES_PORT=5432

# Optional: Full database URL (constructed automatically if not provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/annoy_db

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Annoy - Data Anonymization Tool

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Configuration
# =====================

# Backend API URL (for Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Settings
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./uploads

# Anonymization Settings
DEFAULT_PSEUDONYM_SEED=42

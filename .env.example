# Backend Configuration
# =====================

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=annoy_db
POSTGRES_PORT=5432

# Optional: Full database URL (constructed automatically if not provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/annoy_db

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Annoy - Data Anonymization Tool

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Configuration
# =====================

# Backend API URL (for Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Settings
MAX_UPLOAD_SIZE=1073741824  # 1GB in bytes (increased for banking institutions with large datasets)
UPLOAD_DIR=./uploads

# Anonymization Settings
DEFAULT_PSEUDONYM_SEED=42

# Authentication & Security Settings
# ===================================
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a secure random string (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration time in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI-Enhanced Detection Settings
# ==============================
# Optional: Groq API key for AI-enhanced sensitive data detection
# Get your free API key at: https://console.groq.com/keys
# If not set, detection will use rule-based heuristics only
GROQ_API_KEY=

# Enable AI-enhanced detection (requires GROQ_API_KEY)
# Set to true to enable AI validation for ambiguous columns
ENABLE_AI_DETECTION=false

# Confidence threshold for AI enhancement (0-100)
# Columns with confidence below this threshold will be validated by AI
AI_CONFIDENCE_THRESHOLD=70.0

# Groq model to use for classification
# Recommended: llama-3.3-70b-versatile (fast and accurate)
# Other options: llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
